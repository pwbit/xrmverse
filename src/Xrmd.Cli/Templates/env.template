# Generated by `xrmd server init`. Contains secrets: do not commit.
# The organizations (XRMD_ORGS and the ORG_<ORG>_* keys) are managed by `xrmd server init` and `xrmd server org add|remove`,
# which re-render docker-compose.yml from this file.
# The server image every organization runs. `xrmd server upgrade --to <version>` moves its tag; a custom or local image is yours to maintain.
XRMD_IMAGE={{XRMD_IMAGE}}
# standard: the server loads the Microsoft SDK (xrmd sdk install). none: an SDK-free server (`xrmd server init --sdk-free`, experimental), which never loads it.
XRMD_SDK_MODE={{XRMD_SDK_MODE}}
# The engine of every organization (`xrmd server init --database postgresql`): PostgreSql. Absent: SQL Server.
STORAGE_PROVIDER={{STORAGE_PROVIDER}}
# The password of the postgres user of the bundled postgres service, applied when its pg-data volume is first set up.
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
SA_PASSWORD={{SA_PASSWORD}}
# SQL Server edition of the sqlserver service: Express, Developer (not licensed for production), Standard, Enterprise, EnterpriseCore or a product key. See README, "SQL Server editions".
MSSQL_PID={{MSSQL_PID}}
# Y: you accepted the Microsoft SQL Server license terms of the edition in MSSQL_PID (`xrmd server init|up --accept-sql-server-eula`). See README, "SQL Server editions".
ACCEPT_EULA={{ACCEPT_EULA}}
# Empty: the bundled sqlserver service. Otherwise an external SQL Server, without Database (each organization is a database).
# Empty: the bundled postgres service. Otherwise an external PostgreSQL 16 or later (Host=…;Username=…;Password=…), without Database (each organization is a database).
SQL_CONNECTION=
# With SQL_CONNECTION: the backup directory as a path on the SQL Server host (empty = /var/opt/mssql/backup).
SQL_BACKUP_DIRECTORY=
AUTH_MODE={{AUTH_MODE}}
AUTH_TENANT_ID={{AUTH_TENANT_ID}}
AUTH_DEV_SIGNING_KEY={{AUTH_DEV_SIGNING_KEY}}
UI_ENTRA_CLIENT_ID=
UI_ENTRA_SCOPE=
SEED_ADMIN_NAME=Administrator
# Public host names. XRMD_DOMAIN gives organization <org> the host <org>.<domain>, served on https://<host>/ through a proxy;
# ORG_<ORG>_HOST (below XRMD_ORGS) gives one organization another host. Empty: no public host and no proxy.
XRMD_DOMAIN={{XRMD_DOMAIN}}
# With a host: caddy (the generated proxy service, ports 80 and 443) or external (your own proxy, listed in TRUSTED_PROXIES).
PROXY_MODE={{PROXY_MODE}}
# caddy only. TLS_MODE is acme (certificates from an ACME CA, account e-mail TLS_ACME_EMAIL), files (certs/server.crt and
# certs/server.key, one pair for every host) or internal (Caddy's local CA, for tests and air-gapped sites).
TLS_MODE={{TLS_MODE}}
TLS_ACME_EMAIL={{TLS_ACME_EMAIL}}
# external only: comma-separated IP addresses and CIDR networks of your proxy; forwarded headers are honored from them only.
TRUSTED_PROXIES={{TRUSTED_PROXIES}}
# caddy only: the subnet of the compose network edge (empty: 172.31.250.0/24), where the proxy has the .10 address; and
# EXPOSE_PORTS true to keep publishing each organization's loopback port for diagnostics.
EDGE_SUBNET={{EDGE_SUBNET}}
EXPOSE_PORTS={{EXPOSE_PORTS}}
# Organizations in creation order; each has ORG_<ORG>_PORT (host port) and ORG_<ORG>_ADMIN_OBJECT_ID (initial System Administrator).
# ORG_<ORG>_TDS_PORT (`--tds-port`, AUTH_MODE=Local): the host port of the organization's read-only SQL endpoint, published on
# XRMD_TDS_BIND (default every address, 0.0.0.0).
# XRMD_TDS_BIND=0.0.0.0
XRMD_ORGS=
# File and image columns. Empty = the file-system store at /var/lib/xrmd/files (the `files` volume).
# For an S3-compatible store set FILES_STORE=S3Compatible and the FILES_S3_* values (service url, bucket, keys; the region defaults to us-east-1).
# For Azure Blob Storage set FILES_STORE=AzureBlob, FILES_AZURE_CONTAINER and exactly one of FILES_AZURE_CONNECTION_STRING or FILES_AZURE_SERVICE_URI (https, Microsoft Entra ID).
FILES_STORE=
FILES_ROOT=
FILES_S3_SERVICE_URL=
FILES_S3_BUCKET=
FILES_S3_ACCESS_KEY=
FILES_S3_SECRET_KEY=
FILES_S3_REGION=
FILES_S3_FORCE_PATH_STYLE=
FILES_AZURE_CONNECTION_STRING=
FILES_AZURE_SERVICE_URI=
FILES_AZURE_CONTAINER=
# Client ID of a user-assigned managed identity (only with FILES_AZURE_SERVICE_URI on Azure; a system-assigned identity needs nothing).
AZURE_CLIENT_ID=

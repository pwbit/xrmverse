<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Classic workflows (plan 2.14): the XAML parser and step model (Task 1), the workflow store, activation and registry with
    the pipeline hook (Task 2), what the host found of the customer's workflow SDK (Task 8, WorkflowSdk). Later tasks add the
    engine, the background job handler and the custom activity runner.
  -->

  <ItemGroup>
    <!--
      CoreWF (MIT), the runtime of the custom workflow activities (rulings W17 and W18): System.Activities and System.Xaml for
      .NET. Only the runtime package, and only in this project: UiPath.Workflow (expressions, Roslyn) is never added.
    -->
    <PackageReference Include="UiPath.Workflow.Runtime" Version="6.0.3" />
    <!--
      Power Fx (MIT), the parser and binder of formula columns (plan 2.12c, ruling F1): only the core package, no interpreter;
      formulas are translated to ComputedExpr and evaluated in SQL.
    -->
    <PackageReference Include="Microsoft.PowerFx.Core" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xrmd.Abstractions\Xrmd.Abstractions.csproj" />
    <ProjectReference Include="..\Xrmd.Metadata\Xrmd.Metadata.csproj" />
    <ProjectReference Include="..\Xrmd.Pipeline\Xrmd.Pipeline.csproj" />
    <ProjectReference Include="..\Xrmd.Schema\Xrmd.Schema.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xrmd.Workflows.Tests" />
    <InternalsVisibleTo Include="Xrmd.Integration.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Xrmd.Abstractions\Xrmd.Abstractions.csproj" />
    <ProjectReference Include="..\Xrmd.Metadata\Xrmd.Metadata.csproj" />
    <ProjectReference Include="..\Xrmd.Audit\Xrmd.Audit.csproj" />
    <ProjectReference Include="..\Xrmd.Security\Xrmd.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.15" />

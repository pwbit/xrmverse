    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the CustomApiRegistry constructor that takes its definitions from a delegate. -->
    <InternalsVisibleTo Include="Xrmd.WebApi.Tests" />

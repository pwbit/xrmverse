<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately net462 and strong-named, like Xrmd.TestPlugins: the realistic shape of an existing custom workflow activity
    assembly (plan 2.14, rulings W17 and W18). The only project of the repository that references Microsoft.CrmSdk.Workflow
    (guardrails section 3); it is never shipped.
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Xrmd.TestPlugins\xrmd-test.snk</AssemblyOriginatorKeyFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.Workflow" Version="9.0.2.60" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Activities" />
    <Reference Include="System.ServiceModel" />
  </ItemGroup>

</Project>

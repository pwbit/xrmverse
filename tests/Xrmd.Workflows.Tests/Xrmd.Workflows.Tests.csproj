<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- tests/Directory.Build.props adds the Dataverse client; nothing here references Xrmd.Abstractions, which pins
         its vulnerable transitive packages, so they are pinned here the same way (spec §10, ruling P8). -->
    <!-- pinned: fixes GHSA-23rf-6693-g89p, GHSA-37gx-xxp4-5rgx, GHSA-6588-8gv4-xfgh, GHSA-7hqp-7c5m-4vq6, GHSA-8q5v-6pqq-x66h, GHSA-c399-9853-6jmj, GHSA-cvvh-rhrc-wg4q, GHSA-g8r8-53c2-pm3f, GHSA-mmjf-rqrv-855v, GHSA-r955-8q5j-3h83, GHSA-vrv5-2jg9-4mmr, GHSA-w3x6-4m5h-cxqf -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <!-- pinned: fixes GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Xrmd.Workflows\Xrmd.Workflows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\GoldenXaml.cs" Link="Shared\GoldenXaml.cs" />
    <!-- The metadata of the Query tests: FormulaSqlSizeTests compiles formula columns of xrmv_fxorder to SQL. -->
    <Compile Include="..\Xrmd.Query.Tests\TestMetadata.cs" Link="Shared\TestMetadata.cs" />
    <None Include="..\fixtures\workflows\*.xaml" LinkBase="fixtures\workflows" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\workflows\real\*.xaml" LinkBase="fixtures\workflows\real" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\calculated\*.xaml" LinkBase="fixtures\calculated" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\calculated\real\*.xaml" LinkBase="fixtures\calculated\real" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\rollup\*.xaml" LinkBase="fixtures\rollup" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\rollup\real\*.xaml" LinkBase="fixtures\rollup\real" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\rollup\real\designer\*.xaml" LinkBase="fixtures\rollup\real\designer" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\workflows\yaml\*.yaml" LinkBase="fixtures\workflows\yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\solutions\RealExports\xrmdWfTest_1_0_0_2.zip" LinkBase="fixtures\solutions\RealExports" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

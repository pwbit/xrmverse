<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- Plan 3.3, ruling T11: as in Xrmd.Host, so that the tests run the SQL endpoint without the proprietary SqlParser DLL. -->
    <PackageReference Include="Microsoft.SqlServer.Management.SqlParser" Version="180.9.0" ExcludeAssets="all" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <!-- Plan 2.7a, ruling R1: MetaSchemaParityTests start their own PostgreSQL container (MIT, tests only). -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Xrmd.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Xrmd.Cli\Xrmd.Cli.csproj" />
    <ProjectReference Include="..\..\src\Xrmd.Host\Xrmd.Host.csproj" />
    <ProjectReference Include="..\..\src\Xrmd.Pipeline\Xrmd.Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\SolutionFixtureZip.cs" Link="Shared\SolutionFixtureZip.cs" />
    <Compile Include="..\Shared\PrivateFixtures.cs" Link="Shared\PrivateFixtures.cs" />
    <Compile Include="..\Shared\PublishedApps.cs" Link="Shared\PublishedApps.cs" />
    <Compile Include="..\Shared\FakeComputedColumns.cs" Link="Shared\FakeComputedColumns.cs" />
    <Compile Include="..\Shared\FakeRollupColumns.cs" Link="Shared\FakeRollupColumns.cs" />
    <Compile Include="..\Shared\GoldenXaml.cs" Link="Shared\GoldenXaml.cs" />
    <Compile Include="..\Shared\WorkflowFixtures.cs" Link="Shared\WorkflowFixtures.cs" />
    <Compile Include="..\Shared\WorkflowSolutionBuilder.cs" Link="Shared\WorkflowSolutionBuilder.cs" />
    <Compile Include="..\Shared\CalculatedSolutionFixture.cs" Link="Shared\CalculatedSolutionFixture.cs" />
    <None Include="..\..\fixtures\ui\*.json" LinkBase="fixtures\ui" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\solutions\**\*" LinkBase="fixtures\solutions" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\workflows\*.xaml" LinkBase="fixtures\workflows" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\workflows\real\*.xaml" LinkBase="fixtures\workflows\real" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\calculated\*.xaml" LinkBase="fixtures\calculated" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\rollup\*.xaml" LinkBase="fixtures\rollup" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\rollup\real\*.xaml" LinkBase="fixtures\rollup\real" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\rollup\real\designer\*.xaml" LinkBase="fixtures\rollup\real\designer" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\calculated\real\*.csv" LinkBase="fixtures\calculated\real" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\workflows\yaml\*.yaml" LinkBase="fixtures\workflows\yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\formula\*.json" LinkBase="fixtures\formula" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\TestPlugins.props" />

</Project>

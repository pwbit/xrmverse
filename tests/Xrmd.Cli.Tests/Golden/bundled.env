# Generated by `xrmd server init`. Contains secrets: do not commit.
# The organizations (XRMD_ORGS and the ORG_<ORG>_* keys) are managed by `xrmd server init` and `xrmd server org add|remove`,
# which re-render docker-compose.yml from this file.
# The server image every organization runs. `xrmd server upgrade --to <version>` moves its tag; a custom or local image is yours to maintain.
XRMD_IMAGE=ghcr.io/pwbit/xrmd:2.17.0
SA_PASSWORD=fixture-sa-password-0000
# SQL Server edition of the sqlserver service: Express, Developer (not licensed for production), Standard, Enterprise, EnterpriseCore or a product key. See README, "SQL Server editions".
MSSQL_PID=Express
# Empty: the bundled sqlserver service. Otherwise an external SQL Server, without Database (each organization is a database).
SQL_CONNECTION=
# With SQL_CONNECTION: the backup directory as a path on the SQL Server host (empty = /var/opt/mssql/backup).
SQL_BACKUP_DIRECTORY=
AUTH_MODE=Development
AUTH_TENANT_ID=
AUTH_DEV_SIGNING_KEY=fixturesigningkey0000000000000000000000000000000
UI_ENTRA_CLIENT_ID=
UI_ENTRA_SCOPE=
SEED_ADMIN_NAME=Administrator
# Organizations in creation order; each has ORG_<ORG>_PORT (host port) and ORG_<ORG>_ADMIN_OBJECT_ID (initial System Administrator).
XRMD_ORGS=acme,zenith
ORG_ACME_PORT=5001
ORG_ACME_ADMIN_OBJECT_ID=00000000-0000-0000-0000-000000000001
ORG_ACME_AUDIENCE=
ORG_ZENITH_PORT=5007
ORG_ZENITH_ADMIN_OBJECT_ID=00000000-0000-0000-0000-000000000001
ORG_ZENITH_AUDIENCE=
# File and image columns. Empty = the file-system store at /var/lib/xrmd/files (the `files` volume).
# For an S3-compatible store set FILES_STORE=S3Compatible and the FILES_S3_* values (service url, bucket, keys; the region defaults to us-east-1).
# For Azure Blob Storage set FILES_STORE=AzureBlob, FILES_AZURE_CONTAINER and exactly one of FILES_AZURE_CONNECTION_STRING or FILES_AZURE_SERVICE_URI (https, Microsoft Entra ID).
FILES_STORE=
FILES_ROOT=
FILES_S3_SERVICE_URL=
FILES_S3_BUCKET=
FILES_S3_ACCESS_KEY=
FILES_S3_SECRET_KEY=
FILES_S3_REGION=
FILES_S3_FORCE_PATH_STYLE=
FILES_AZURE_CONNECTION_STRING=
FILES_AZURE_SERVICE_URI=
FILES_AZURE_CONTAINER=
# Client ID of a user-assigned managed identity (only with FILES_AZURE_SERVICE_URI on Azure; a system-assigned identity needs nothing).
AZURE_CLIENT_ID=

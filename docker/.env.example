# SQL Server SA password (must satisfy SQL Server complexity rules)
SA_PASSWORD=Change_me_Str0ng!
# SQL Server edition: Express (default, free, limited), Developer (not licensed for production), Standard,
# Enterprise, EnterpriseCore, or a product key XXXXX-XXXXX-XXXXX-XXXXX-XXXXX. See README, "SQL Server editions".
# A mssql-data volume created before this setting existed ran Developer: set Developer here to keep that edition.
MSSQL_PID=Express
# Set Y only after you have read and accepted Microsoft's license terms for the edition above
# (see README, "SQL Server editions", License terms). The sqlserver service does not start without it.
ACCEPT_EULA=
# docker-compose.postgres.yml only (PostgreSQL instead of SQL Server): the postgres user's password, applied when the
# pg-data volume is first set up. Letters and digits keep it valid inside the Npgsql connection string.
POSTGRES_PASSWORD=Changeme0Str0ng
# Entra | Development | Local
AUTH_MODE=Development
# Audience = the base URL clients use to reach xrmd (with trailing slash)
AUTH_AUDIENCE=http://localhost:5000/
# AUTH_MODE=Local only: container path of a one-shot file holding the initial administrator's password (never the password itself)
IDP_INITIAL_ADMIN_PASSWORD_FILE=
# Required when AUTH_MODE=Entra
AUTH_TENANT_ID=
# Required when AUTH_MODE=Development (>= 32 chars)
# Generate one with: openssl rand -hex 32
AUTH_DEV_SIGNING_KEY=
# Web admin sign-in with Entra (AUTH_MODE=Entra): client id of the SPA app registration and the API scope
UI_ENTRA_CLIENT_ID=
UI_ENTRA_SCOPE=
# Host folder of the Microsoft SDK, mounted read-only at /var/lib/xrmd/sdk. Default ${HOME}/.xrmd/sdk, where
# `xrmd sdk install` writes after you accept Microsoft's license terms. Set it when the SDK is elsewhere or HOME is unset.
# XRMD_SDK_HOST_DIR=
# Host interface for port 5000 (default loopback only; 0.0.0.0 exposes it on the network)
# XRMD_BIND=127.0.0.1
# SQL (TDS) endpoint, read-only, with AUTH_MODE=Local (see the commented Tds lines of docker-compose.yml): its host port and
# host interface (default every address; clients connect to <host>,<port> with TLS).
# TDS_PORT=5558
# XRMD_TDS_BIND=0.0.0.0
SEED_ORG_NAME=xrmd
# Object id (oid claim) of the initial system administrator
SEED_ADMIN_OBJECT_ID=00000000-0000-0000-0000-000000000001
SEED_ADMIN_NAME=Administrator
# ISO 4217 code of the base currency of a new organization (default EUR). It is fixed once the organization exists.
# SEED_BASE_CURRENCY=EUR
# File and image columns. Empty = the file-system store at /var/lib/xrmd/files (the `files` volume).
# For an S3-compatible store set FILES_STORE=S3Compatible and the FILES_S3_* values (service url, bucket, keys; the region defaults to us-east-1).
# For Azure Blob Storage set FILES_STORE=AzureBlob, FILES_AZURE_CONTAINER and exactly one of FILES_AZURE_CONNECTION_STRING or FILES_AZURE_SERVICE_URI (https, Microsoft Entra ID).
FILES_STORE=
FILES_ROOT=
FILES_S3_SERVICE_URL=
FILES_S3_BUCKET=
FILES_S3_ACCESS_KEY=
FILES_S3_SECRET_KEY=
FILES_S3_REGION=
FILES_S3_FORCE_PATH_STYLE=
FILES_AZURE_CONNECTION_STRING=
FILES_AZURE_SERVICE_URI=
FILES_AZURE_CONTAINER=
# Client ID of a user-assigned managed identity (only with FILES_AZURE_SERVICE_URI on Azure; a system-assigned identity needs nothing).
AZURE_CLIENT_ID=

      "patch": {
        "operationId": "UpdateRow",
        "summary": "Update a row",
        "description": "Changes the given columns of an existing row and returns the row as saved. The row must exist.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "table",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Table",
            "description": "The table of the rows, picked from the list or given as its set name.",
            "x-ms-url-encoding": "single",
            "x-ms-dynamic-values": {
              "operationId": "GetTables",
              "value-collection": "value",
              "value-path": "entitySetName",
              "value-title": "displayName",
              "parameters": {}
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Row ID",
            "description": "The unique identifier of the row, a GUID."
          },
          {
            "name": "Prefer",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "return=representation",

      "post": {
        "operationId": "OnRowChanged",
        "summary": "When a row is created, updated or deleted",
        "description": "Starts the flow when a row of the chosen table is created, updated or deleted. The server calls the flow once for each change, after the change is saved.",
        "x-ms-visibility": "important",
        "x-ms-trigger": "single",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "subscription",
            "in": "body",
            "required": true,
            "x-ms-summary": "Trigger settings",
            "description": "Which table and which changes start the flow.",
            "schema": {
              "type": "object",
              "required": [
                "table",
                "changes",
                "callbackUrl"
              ],
              "properties": {
                "table": {
                  "type": "string",
                  "x-ms-summary": "Table to watch",
                  "description": "The table to watch, picked from the list or given by its logical name.",
                  "x-ms-dynamic-values": {
                    "operationId": "GetTables",
                    "value-collection": "value",
                    "value-path": "logicalName",
                    "value-title": "displayName",
                    "parameters": {}
                  }
                },
                "changes": {
                  "type": "string",
                  "x-ms-summary": "Changes",
                  "description": "Which changes start the flow.",
                  "enum": [
                    "create",
                    "update",
                    "delete",
                    "create,update",
                    "create,delete",
                    "update,delete",
                    "create,update,delete"
                  ],
                  "x-ms-enum-values": [
                    {
                      "value": "create",
                      "displayName": "Created"
                    },
                    {
                      "value": "update",
                      "displayName": "Updated"
                    },
                    {
                      "value": "delete",
                      "displayName": "Deleted"
                    },
                    {
                      "value": "create,update",
                      "displayName": "Created or updated"
                    },
                    {
                      "value": "create,delete",
                      "displayName": "Created or deleted"
                    },
                    {
                      "value": "update,delete",
                      "displayName": "Updated or deleted"
                    },
                    {
                      "value": "create,update,delete",
                      "displayName": "Created, updated or deleted"
                    }
                  ]
                },
                "filteringColumns": {
                  "type": "string",
                  "x-ms-summary": "Columns to watch (updates)",
                  "x-ms-visibility": "advanced",
                  "description": "The logical names of the columns, separated by commas. An update starts the flow only when one of them changed; empty means any column. Applies to updates only."
                },
                "callbackUrl": {
                  "type": "string",
                  "x-ms-summary": "Callback URL",
                  "x-ms-visibility": "internal",
                  "x-ms-notification-url": true,
                  "description": "The address the server calls when a row changes. The platform fills it in."
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The subscription was created.",
            "headers": {
              "Location": {
                "type": "string",
                "description": "The address that removes the subscription."
              }
            },
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The ID of the subscription."
                }
              }
            }
          }
        }
      }
    },

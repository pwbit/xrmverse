  "paths": {
    "/api/data/v9.2/{table}": {
      "get": {
        "operationId": "ListRows",
        "summary": "List rows",
        "description": "Lists the rows of a table, one page at a time, filtered and sorted by OData query options or by a FetchXML query.",
        "x-ms-visibility": "important",
        "x-ms-pageable": {
          "nextLinkName": "@odata.nextLink"
        },
        "parameters": [
          {
            "name": "table",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Table",
            "description": "The table of the rows, picked from the list or given as its set name.",
            "x-ms-url-encoding": "single",
            "x-ms-dynamic-values": {
              "operationId": "GetTables",
              "value-collection": "value",
              "value-path": "entitySetName",
              "value-title": "displayName",
              "parameters": {}
            }
          },
          {
            "name": "$select",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Columns to return",
            "description": "The logical names of the columns to return, separated by commas.",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "$filter",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Filter rows",
            "description": "An OData filter expression that the rows must match, for example statecode eq 0.",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "$orderby",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Sort by",
            "description": "The columns to sort the rows by, each followed by asc or desc, separated by commas.",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "$expand",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Expand query",
            "description": "The related rows to return with each row, as OData navigation properties.",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "$top",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "x-ms-summary": "Row count",
            "description": "The largest number of rows to return.",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "fetchXml",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "FetchXML query",
            "description": "A FetchXML query on the table, used in place of the OData query options.",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "Prefer",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "odata.include-annotations=\"*\"",
            "x-ms-summary": "Response preference",
            "description": "Asks the server for the formatted values and the other annotations of the columns.",
            "x-ms-visibility": "internal"
          }
        ],
        "responses": {
          "200": {
            "description": "The page of rows.",
            "schema": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "array",
                  "x-ms-summary": "Rows",
                  "description": "The rows of the page.",
                  "items": {
                    "type": "object",
                    "x-ms-dynamic-schema": {
                      "operationId": "GetTableSchema",
                      "parameters": {
                        "name": {
                          "parameter": "table"
                        },
                        "use": "read"
                      }
                    }
                  }
                },
                "@odata.nextLink": {
                  "type": "string",
                  "x-ms-summary": "Next page link",
                  "description": "The address of the next page, when there is one.",
                  "x-ms-visibility": "internal"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "AddRow",
        "summary": "Add a new row",
        "description": "Adds a row to a table and returns the row as saved.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "table",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Table",
            "description": "The table of the rows, picked from the list or given as its set name.",
            "x-ms-url-encoding": "single",
            "x-ms-dynamic-values": {
              "operationId": "GetTables",
              "value-collection": "value",
              "value-path": "entitySetName",
              "value-title": "displayName",
              "parameters": {}
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "return=representation",
            "x-ms-summary": "Return the row",
            "description": "Asks the server to answer with the row as saved.",
            "x-ms-visibility": "internal"
          },
          {
            "name": "item",
            "in": "body",
            "required": true,
            "x-ms-summary": "Row",
            "description": "The columns of the new row.",
            "schema": {
              "type": "object",
              "x-ms-dynamic-schema": {
                "operationId": "GetTableSchema",
                "parameters": {
                  "name": {
                    "parameter": "table"
                  },
                  "use": "create"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The new row.",
            "schema": {
              "type": "object",
              "x-ms-dynamic-schema": {
                "operationId": "GetTableSchema",
                "parameters": {
                  "name": {
                    "parameter": "table"
                  },
                  "use": "read"
                }
              }
            }
          }
        }
      }
    },

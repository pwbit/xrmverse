{
  "swagger": "2.0",
  "info": {
    "title": "xrmverse",
    "description": "Read, add, update and delete the rows of the tables of an xrmverse server, and run its custom APIs, from cloud flows and apps.",
    "version": "1.0.0",
    "contact": {
      "name": "xrmverse",
      "url": "https://xrmverse.com"
    }
  },
  "host": "{{HOST}}",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "oauth2_auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize",

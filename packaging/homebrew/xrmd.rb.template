# Homebrew formula template for xrmd. Placeholders are filled in when a release is published:
#   {{VERSION}}, {{URL_ARM64}}, {{SHA256_ARM64}}, {{URL_X64}}, {{SHA256_X64}}
# URL_* point at the xrmd-osx-arm64.tar.gz / xrmd-osx-x64.tar.gz assets of the GitHub release.
class Xrmd < Formula
  desc "Command line for administering an xrmverse (Dataverse-compatible) server"
  homepage "https://github.com/pwbit/XRMverse"
  license "Apache-2.0"
  version "{{VERSION}}"

  on_macos do
    if Hardware::CPU.arm?
      url "{{URL_ARM64}}"
      sha256 "{{SHA256_ARM64}}"
    else
      url "{{URL_X64}}"
      sha256 "{{SHA256_X64}}"
    end
  end

  def caveats
    <<~EOS
      xrmverse is an independent project and is not affiliated with, endorsed by or sponsored by Microsoft. Microsoft, Dataverse, Dynamics 365 and Power Apps are trademarks of the Microsoft group of companies.
    EOS
  end

  def install
    bin.install "xrmd"
    prefix.install "LICENSE"
    prefix.install "NOTICE"
    prefix.install "THIRD_PARTY_NOTICES.md"
    prefix.install "dotnet-runtime-LICENSE.txt"
    prefix.install "dotnet-runtime-THIRD-PARTY-NOTICES.txt"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/xrmd --version")
  end
end
